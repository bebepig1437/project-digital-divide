# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=your_resend_api_key_here

# Recipient email where contact and volunteer submissions are sent.
# NOTE: While using Resend sandbox (onboarding@resend.dev), Resend strictly requires
# this to match the Resend account owner email.
# Once your custom domain is verified on Resend, you can change this to any email.
TO_EMAIL=josephbhu2010@gmail.com

# Sender email
# Use "Project Digital Divide <onboarding@resend.dev>" for testing.
# For production (after domain verification), use: "Project Digital Divide <team@projectdigitaldivide.org>"
FROM_EMAIL=Project Digital Divide <onboarding@resend.dev>
